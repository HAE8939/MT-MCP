    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
