# Copy to .env and replace every placeholder. Never commit .env.
# Generate a token: openssl rand -hex 32

PORT=8787
HOST=0.0.0.0

# Shared company credential. Required on every /mcp request.
# Send Authorization: Bearer <token> or X-API-Key: <token>.
# Rotate by changing this value and restarting the container.
MCP_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32

# Optional. Comma-separated Host names allowed to call /mcp.
# Leave empty on a NAS until the hostname is stable. /health is not checked.
# MCP_ALLOWED_HOSTS=nas.local,192.168.1.20

# Optional. Comma-separated Origin hostnames. Browser callers are rejected
# unless listed. Cursor and other non-browser MCP clients omit Origin.
# MCP_ALLOWED_ORIGINS=

# Tencent COS. The bucket should already be public-read for the prefix below.
# Lifecycle (delete after about 1 day) is configured on the bucket, not here.
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=dmds-images-1259154611
COS_PREFIX=dmds/

# Optional public URL base. When unset, URLs use
# https://<bucket>.cos.<region>.myqcloud.com/<key>
# COS_CDN_DOMAIN=https://img.example.com

# public-read sets x-cos-acl on each object. Use default to inherit the bucket ACL.
# COS_OBJECT_ACL=public-read

# Max image size in bytes. Default 8388608 (8 MiB).
# MAX_UPLOAD_BYTES=8388608

# Camera-annotation HTML pack. No secrets. true (default) registers
# camera_annot_validate_bootstrap and camera_annot_build_html.
# Set false to hide them. The MCP URL and token stay the same.
# PACK_CAMERA_ANNOT_ENABLED=true

# Design prompt library. No secrets. true (default) registers
# design_list_prompts and design_get_prompt.
# Set false to hide them. The MCP URL and token stay the same.
# PACK_DESIGN_PROMPTS_ENABLED=true

# Docker secrets alternative: leave the value unset and point at a file.
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token
# COS_SECRET_ID_FILE=/run/secrets/cos_secret_id
# COS_SECRET_KEY_FILE=/run/secrets/cos_secret_key
